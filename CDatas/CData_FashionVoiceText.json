{
  "className": "CData_FashionVoiceText",
  "timestamp": "2025-10-23T19:25:18.747Z",
  "data": {
    "60001001": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001001",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"(Utterance).\"",
          "m_voice": "\"Play_vo_20230_battle_attack_A2_01\""
        }
      }
    },
    "60001002": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001002",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"This time, it's your life I'm after.\"",
          "m_voice": "\"Play_vo_20230_battle_maxskill01_A2_01\""
        }
      }
    },
    "60001003": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001003",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"(Utterance).\"",
          "m_voice": "\"Play_vo_20230_battle_maxskill02_A2_01\""
        }
      }
    },
    "60001004": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001004",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"I'm going to enjoy watching you squirm.\"",
          "m_voice": "\"Play_vo_20230_battle_skill01_A2_01\""
        }
      }
    },
    "60001005": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001005",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"(Utterance).\"",
          "m_voice": "\"Play_vo_20230_battle_hit_A2_01\""
        }
      }
    },
    "60001006": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001006",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"What a shameless way to go... meow.\"",
          "m_voice": "\"Play_vo_20230_battle_death_A2_01\""
        }
      }
    },
    "60001007": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001007",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Want my help? Just know—I always collect what's owed.\"",
          "m_voice": "\"Play_vo_20230_battle_array_A2_01\""
        }
      }
    },
    "60001008": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001008",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"There's more than one way to take what you desire, meow.\"",
          "m_voice": "\"Play_vo_20230_battle_stagewin_A2_01\""
        }
      }
    },
    "60001009": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001009",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"It seems you still haven't realized what might be of value to me.\"",
          "m_voice": "\"Play_vo_20230_system_show_A2_01\""
        }
      }
    },
    "60001010": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001010",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"You seem awfully interested in my secrets.\"",
          "m_voice": "\"Play_vo_20230_system_greet_A2_01\""
        }
      }
    },
    "60001011": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001011",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"All this treasure... You do know how to please a lady.\"",
          "m_voice": "\"Play_vo_20230_system_levelup_A2_01\""
        }
      }
    },
    "60001012": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001012",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"So, got our next mark in mind?\"",
          "m_voice": "\"Play_vo_20230_system_breakthrough_A2_01\""
        }
      }
    },
    "60001013": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001013",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Found any new baubles, meow?\"",
          "m_voice": "\"Play_vo_20230_system_dispatch_A2_01\""
        }
      }
    },
    "60001014": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001014",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Hmm? Where was I? That's for me to know.\"",
          "m_voice": "\"Play_vo_20230_system_idle_A2_01\""
        }
      }
    },
    "60001015": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001015",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"All I need in this life of crime, is you.\"",
          "m_voice": "\"Play_vo_20230_system_transfusion_A2_01\""
        }
      }
    },
    "60001016": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001016",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"The one piece missing from my collection.\"",
          "m_voice": "\"Play_vo_20230_system_gift01_A2_01\""
        }
      }
    },
    "60001017": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001017",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"You're not giving it to me? Am I not your most precious treasure?\"",
          "m_voice": "\"Play_vo_20230_system_gift02_A2_01\""
        }
      }
    },
    "60001018": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001018",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"I'm enjoying your little surprises.\"",
          "m_voice": "\"Play_vo_20230_system_affinityup_A2_01\""
        }
      }
    },
    "60001019": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001019",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Still keeping your heart from me, even now?\"",
          "m_voice": "\"Play_vo_20230_system_affinitymax_A2_01\""
        }
      }
    },
    "60001020": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001020",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Hmm? Nothing escapes my eyes.\"",
          "m_voice": "\"Play_vo_20230_system_tapgeneric01_A2_01\""
        }
      }
    },
    "60001021": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001021",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Need an outfit for sneaking around? I'd love to see how you look in it.\"",
          "m_voice": "\"Play_vo_20230_system_tapgeneric02_A2_01\""
        }
      }
    },
    "60001022": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001022",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Cover your eyes—it's time for sensory training. Let's see if you can detect me.\"",
          "m_voice": "\"Play_vo_20230_system_taphead01_A2_01\""
        }
      }
    },
    "60001023": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001023",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"You can't hide from me with your little facade.\"",
          "m_voice": "\"Play_vo_20230_system_taphead02_A2_01\""
        }
      }
    },
    "60001024": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001024",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Find anything interesting?\"",
          "m_voice": "\"Play_vo_20230_system_tapsp01_A2_01\""
        }
      }
    },
    "60001025": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001025",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Want it? Then take it yourself, like a true burglar.\"",
          "m_voice": "\"Play_vo_20230_system_tapsp02_A2_01\""
        }
      }
    },
    "60001026": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001026",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"(Utterance).\"",
          "m_voice": "\"Play_vo_20230_str_surprised_A2_01\""
        }
      }
    },
    "60001027": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001027",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"(Utterance).\"",
          "m_voice": "\"Play_vo_20230_str_joyful_A2_01\""
        }
      }
    },
    "60001028": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001028",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"(Utterance).\"",
          "m_voice": "\"Play_vo_20230_str_irritated_A2_01\""
        }
      }
    },
    "60001029": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001029",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"(Utterance).\"",
          "m_voice": "\"Play_vo_20230_str_confused_A2_01\""
        }
      }
    },
    "60001030": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60001030",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"(Utterance).\"",
          "m_voice": "\"Play_vo_20230_str_calm_A2_01\""
        }
      }
    },
    "60003001": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003001",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"(Utterance).\"",
          "m_voice": "\"Play_vo_20160_battle_attack_A2_01\""
        }
      }
    },
    "60003002": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003002",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"My passion knows no limits!\"",
          "m_voice": "\"Play_vo_20160_battle_maxskill01_A2_01\""
        }
      }
    },
    "60003003": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003003",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"(Utterance).\"",
          "m_voice": "\"Play_vo_20160_battle_maxskill02_A2_01\""
        }
      }
    },
    "60003004": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003004",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Let the flames rise!\"",
          "m_voice": "\"Play_vo_20160_battle_skill01_A2_01\""
        }
      }
    },
    "60003005": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003005",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"(Utterance).\"",
          "m_voice": "\"Play_vo_20160_battle_hit_A2_01\""
        }
      }
    },
    "60003006": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003006",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"It's not... my time...\"",
          "m_voice": "\"Play_vo_20160_battle_death_A2_01\""
        }
      }
    },
    "60003007": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003007",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"This outfit... it's a bit hard to move in.\"",
          "m_voice": "\"Play_vo_20160_battle_array_A2_01\""
        }
      }
    },
    "60003008": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003008",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Let's take care of this quickly. The ceremony can't wait.\"",
          "m_voice": "\"Play_vo_20160_battle_stagewin_A2_01\""
        }
      }
    },
    "60003009": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003009",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"My devotion is pure, like this white gown.\"",
          "m_voice": "\"Play_vo_20160_system_show_A2_01\""
        }
      }
    },
    "60003010": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003010",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Whatever this journey may bring, I will be there along with you.\"",
          "m_voice": "\"Play_vo_20160_system_greet_A2_01\""
        }
      }
    },
    "60003011": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003011",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"I won't let my loved ones get hurt anymore.\"",
          "m_voice": "\"Play_vo_20160_system_levelup_A2_01\""
        }
      }
    },
    "60003012": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003012",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Could this be the power of hope?\"",
          "m_voice": "\"Play_vo_20160_system_breakthrough_A2_01\""
        }
      }
    },
    "60003013": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003013",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Is this really the time for that...\"",
          "m_voice": "\"Play_vo_20160_system_dispatch_A2_01\""
        }
      }
    },
    "60003014": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003014",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Take your time. I've waited this long for you—what's a moment more?\"",
          "m_voice": "\"Play_vo_20160_system_idle_A2_01\""
        }
      }
    },
    "60003015": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003015",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"I should have changed my outfit first!\"",
          "m_voice": "\"Play_vo_20160_system_transfusion_A2_01\""
        }
      }
    },
    "60003016": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003016",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Feeling alright? It's not like you to get all nervous.\"",
          "m_voice": "\"Play_vo_20160_system_gift01_A2_01\""
        }
      }
    },
    "60003017": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003017",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Wow... you've always known what I love, haven't you?\"",
          "m_voice": "\"Play_vo_20160_system_gift02_A2_01\""
        }
      }
    },
    "60003018": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003018",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"I can't feel anything... have I become jaded already?\"",
          "m_voice": "\"Play_vo_20160_system_affinityup_A2_01\""
        }
      }
    },
    "60003019": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003019",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"As I put on this gown, I feel something stir within me... and I know it’s because of you.\"",
          "m_voice": "\"Play_vo_20160_system_affinitymax_A2_01\""
        }
      }
    },
    "60003020": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003020",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Did I let you down?\"",
          "m_voice": "\"Play_vo_20160_system_tapgeneric01_A2_01\""
        }
      }
    },
    "60003021": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003021",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"My dress...it's slipping a little... Could you help me with it?\"",
          "m_voice": "\"Play_vo_20160_system_tapgeneric02_A2_01\""
        }
      }
    },
    "60003022": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003022",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Keep this up and you'll make me angry!\"",
          "m_voice": "\"Play_vo_20160_system_taphead01_A2_01\""
        }
      }
    },
    "60003023": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003023",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"Without even noticing, you've grown so reliable and composed... it makes me feel a little lonely.\"",
          "m_voice": "\"Play_vo_20160_system_taphead02_A2_01\""
        }
      }
    },
    "60003024": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003024",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"What's this? Why are you so focused on my hands—are you planning to give me something?\"",
          "m_voice": "\"Play_vo_20160_system_tapsp01_A2_01\""
        }
      }
    },
    "60003025": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003025",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"No matter how difficult or dangerous the path ahead may be, I will fight to protect our future.\"",
          "m_voice": "\"Play_vo_20160_system_tapsp02_A2_01\""
        }
      }
    },
    "60003026": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003026",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"(Utterance).\"",
          "m_voice": "\"Play_vo_20160_str_surprised_A2_01\""
        }
      }
    },
    "60003027": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
          "m_bError": null,
          "m_VoiceId": "60003027",
          "m_TextId": "1",
          "m_NextId": null,
          "m_mText": "\"(Utterance).\"",
          "m_voice": "\"Play_vo_20160_str_joyful_A2_01\""
        }
      }
    },
    "60003028": {
      "_type": "nested_dictionary",
      "_count": 1,
      "_processed": 1,
      "data": {
        "1": {
